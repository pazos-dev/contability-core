{
  "name": "@pazos-dev/contability",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo del motor contable: el core embebible y sus adaptadores, publicados por separado",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pazos-dev/contability-core.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "check:project": "node scripts/check-project.mjs",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "sync:iso4217": "pnpm --filter @pazos-dev/contability-core run sync:iso4217",
    "check": "pnpm run check:project && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "packageManager": "pnpm@11.25.0"
}
